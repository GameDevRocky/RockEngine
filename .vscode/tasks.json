{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "RockEngine: configure (qt-mingw-debug)",
            "type": "shell",
            "command": "\"C:/Program Files/CMake/bin/cmake.exe\" --preset qt-mingw-debug",
            "problemMatcher": [],
            "detail": "Configure with the qt-mingw-debug CMake preset (Qt + MinGW)."
        },
        {
            "label": "RockEngine: build (qt-mingw-debug)",
            "type": "shell",
            "command": "\"C:/Program Files/CMake/bin/cmake.exe\" --build --preset qt-mingw-debug",
            "dependsOn": ["RockEngine: configure (qt-mingw-debug)"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "detail": "Build with the qt-mingw-debug CMake build preset."
        }
    ]
}