{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "RockEngine: configure",
            "type": "shell",
            "command": "cmake --preset local",
            "problemMatcher": [],
            "detail": "Configure with the 'local' preset (run ./setup.ps1 or ./setup.sh first to generate it)."
        },
        {
            "label": "RockEngine: build",
            "type": "shell",
            "command": "cmake --build --preset local",
            "dependsOn": ["RockEngine: configure"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc", "$msCompile"],
            "detail": "Build with the 'local' preset."
        },
        {
            "label": "RockEngine: configure tests",
            "type": "shell",
            "command": "cmake --preset ci-windows",
            "problemMatcher": [],
            "detail": "Configure the headless test lane. Needs no Qt; separate build dir from 'local'."
        },
        {
            "label": "RockEngine: test",
            "type": "shell",
            "command": "cmake --build --preset ci-windows && ctest --preset ci-windows",
            "dependsOn": ["RockEngine: configure tests"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "detail": "Build and run the headless unit tests -- the same lane CI runs on Linux."
        }
    ]
}
