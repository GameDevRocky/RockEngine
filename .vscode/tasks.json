{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "RockEngine: configure",
            "type": "shell",
            "command": "cmake --preset local",
            "problemMatcher": [],
            "detail": "Configure with the 'local' preset (run ./setup.ps1 or ./setup.sh first to generate it)."
        },
        {
            "label": "RockEngine: build",
            "type": "shell",
            "command": "cmake --build --preset local",
            "dependsOn": ["RockEngine: configure"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc", "$msCompile"],
            "detail": "Build with the 'local' preset."
        }
    ]
}
