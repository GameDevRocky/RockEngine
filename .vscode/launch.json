{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug RockEngine",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}", // Crucial for finding engine assets
            "environment": [
                { "name": "PATH", "value": "${env:PATH};C:\\msys64\\ucrt64\\bin" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "visualizerFile": "${workspaceFolder}/.vscode/qt6.natvis", // Optional: for better Qt variable viewing
            "ignoreFailures": true
        }
    ]
}