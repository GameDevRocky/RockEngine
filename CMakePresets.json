{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows · MSVC (Ninja)",
      "description": "Qt comes from CMAKE_PREFIX_PATH (env var or CMakeUserPresets.json). Compiler from Visual Studio.",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": ["Windows"] }
      }
    },
    {
      "name": "macos",
      "displayName": "macOS · Clang (Ninja)",
      "description": "Qt comes from CMAKE_PREFIX_PATH (env var or CMakeUserPresets.json). Compiler from Xcode/Clang.",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux",
      "displayName": "Linux · GCC/Clang (Ninja)",
      "description": "Qt comes from CMAKE_PREFIX_PATH (env var or CMakeUserPresets.json).",
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "description": "The headless lane: Engine + Player + tests, no Qt and no Python runtime staging.",
      "cacheVariables": {
        "ROCKENGINE_BUILD_EDITOR": "OFF",
        "ROCKENGINE_BUILD_TESTS": "ON",
        "ROCKENGINE_STAGE_PLAYER_RUNTIME": "OFF"
      }
    },
    {
      "name": "ci-linux",
      "displayName": "CI · Linux headless (Engine + tests)",
      "description": "What GitHub Actions runs. No Qt required.",
      "inherits": ["ci-base", "linux"]
    },
    {
      "name": "ci-windows",
      "displayName": "CI · Windows headless (Engine + tests)",
      "description": "The same headless lane as CI, runnable locally. Needs no Qt on CMAKE_PREFIX_PATH.",
      "inherits": ["ci-base", "windows-msvc"]
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "ci-linux", "configurePreset": "ci-linux" },
    { "name": "ci-windows", "configurePreset": "ci-windows" }
  ],
  "testPresets": [
    {
      "name": "ci-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "ci-linux", "inherits": "ci-base", "configurePreset": "ci-linux" },
    { "name": "ci-windows", "inherits": "ci-base", "configurePreset": "ci-windows" }
  ]
}
