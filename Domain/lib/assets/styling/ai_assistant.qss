/* AI Assistant dock ---------------------------------------------------------
 * Kept separate from the editor-wide theme so this panel can evolve without
 * leaking selectors into the inspector, hierarchy, or other authoring tools.
 */

QWidget#AiAssistant {
    background: palette(window);
}

/* The login page keeps the editor's original gray. The moving radial widgets
 * drift behind the content. Overall intensity is controlled by
 * kGradientColorStrength in AiChatGui.cpp because Qt QSS has no variables. */
QWidget#AiLoginPage,
QWidget#AiGradientLayer {
    background: palette(window);
}

QWidget#AiLoginSurface,
QWidget#AiLoginContent,
QWidget#AiLoginPage QLabel {
    background: transparent;
}

QWidget#AiGradientBlob {
    background: transparent;
    border: none;
}

QWidget#AiGradientBlob[providerTheme="openai"][gradientRole="primary"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.43, fy: 0.42,
        stop: 0.00 rgba(82, 113, 190, 205),
        stop: 0.34 rgba(75, 99, 166, 145),
        stop: 0.70 rgba(88, 91, 106, 58),
        stop: 1.00 rgba(88, 91, 106, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="openai"][gradientRole="secondary"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.57, fy: 0.43,
        stop: 0.00 rgba(120, 78, 160, 190),
        stop: 0.38 rgba(99, 73, 137, 130),
        stop: 0.74 rgba(91, 88, 104, 45),
        stop: 1.00 rgba(91, 88, 104, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="openai"][gradientRole="accent"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.48, fy: 0.57,
        stop: 0.00 rgba(63, 132, 177, 180),
        stop: 0.38 rgba(71, 111, 147, 120),
        stop: 0.74 rgba(87, 94, 108, 42),
        stop: 1.00 rgba(87, 94, 108, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="claude"][gradientRole="primary"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.43, fy: 0.42,
        stop: 0.00 rgba(218, 112, 66, 210),
        stop: 0.36 rgba(184, 83, 43, 145),
        stop: 0.72 rgba(112, 79, 65, 50),
        stop: 1.00 rgba(112, 79, 65, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="claude"][gradientRole="secondary"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.57, fy: 0.43,
        stop: 0.00 rgba(164, 69, 37, 175),
        stop: 0.42 rgba(137, 67, 43, 112),
        stop: 0.76 rgba(98, 78, 69, 38),
        stop: 1.00 rgba(98, 78, 69, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="claude"][gradientRole="accent"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.48, fy: 0.57,
        stop: 0.00 rgba(205, 135, 54, 185),
        stop: 0.38 rgba(171, 103, 43, 125),
        stop: 0.74 rgba(112, 83, 66, 42),
        stop: 1.00 rgba(112, 83, 66, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="gemini"][gradientRole="primary"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.43, fy: 0.42,
        stop: 0.00 rgba(66, 133, 244, 205),
        stop: 0.36 rgba(62, 112, 207, 140),
        stop: 0.72 rgba(82, 94, 116, 48),
        stop: 1.00 rgba(82, 94, 116, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="gemini"][gradientRole="secondary"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.57, fy: 0.43,
        stop: 0.00 rgba(234, 67, 53, 195),
        stop: 0.38 rgba(191, 65, 55, 132),
        stop: 0.74 rgba(110, 78, 75, 44),
        stop: 1.00 rgba(110, 78, 75, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="gemini"][gradientRole="accent"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.48, fy: 0.57,
        stop: 0.00 rgba(251, 188, 4, 185),
        stop: 0.38 rgba(204, 151, 17, 125),
        stop: 0.74 rgba(119, 101, 53, 42),
        stop: 1.00 rgba(119, 101, 53, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="gemini"][gradientIndex="3"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.45, fy: 0.55,
        stop: 0.00 rgba(52, 168, 83, 195),
        stop: 0.38 rgba(48, 139, 74, 130),
        stop: 0.74 rgba(72, 102, 79, 44),
        stop: 1.00 rgba(72, 102, 79, 0)
    );
}

QWidget#AiGradientBlob[providerTheme="gemini"][gradientIndex="4"] {
    background: qradialgradient(
        cx: 0.50, cy: 0.50, radius: 0.42, fx: 0.56, fy: 0.47,
        stop: 0.00 rgba(66, 133, 244, 180),
        stop: 0.38 rgba(59, 112, 205, 120),
        stop: 0.74 rgba(80, 93, 114, 42),
        stop: 1.00 rgba(80, 93, 114, 0)
    );
}

QStackedWidget#AiPages {
    border: none;
}

QWidget#AiHeaderOverlay {
    background-color: palette(window);
    border: none;
}

QWidget#AiComposerOverlay {
    background: transparent;
    border: none;
}

QWidget#AiLoginPage QLabel#AiLoginLogo {
    background: white;
    border: 2px solid rgb(218, 218, 218);
    border-radius: 41px;
    color: rgb(20, 20, 20);
    font-size: 24px;
    font-weight: 700;
}

QLabel#AiLoginHeading {
    font-size: 20px;
    font-weight: 650;
}

QLabel#AiMutedText {
    color: rgb(180, 180, 184);
}

QLabel#AiLoginError {
    background: rgb(55, 55, 58);
    border: 1px solid rgb(205, 76, 76);
    border-radius: 8px;
    color: rgb(226, 226, 229);
    padding: 10px 12px;
}

QLabel#AiLink {
    background: transparent;
    color: rgb(190, 190, 194);
}

QWidget#AiAssistant QComboBox {
    background: rgba(40, 40, 43, 225);
    border: 1px solid rgb(83, 83, 83);
    border-radius: 6px;
}

QWidget#AiCredentialFrame {
    background: rgba(37, 37, 40, 225);
    border: 1px solid rgb(83, 83, 83);
    border-radius: 9px;
}

QLineEdit#AiCredentialInput {
    background: transparent;
    border: none;
    padding: 9px 10px;
}

QLineEdit#AiCredentialInput:hover,
QLineEdit#AiCredentialInput:focus {
    background: transparent;
    border: none;
}

QPushButton#AiCredentialSubmit {
    background: rgb(63, 63, 66);
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 0px;
    font-size: 17px;
    font-weight: 600;
}

QPushButton#AiSecondaryButton {
    min-height: 30px;
    background: rgb(43, 43, 43);
    border: 1px solid rgb(69, 69, 69);
    border-radius: 7px;
}

QPushButton#AiHeaderAction {
    background: transparent;
    border: none;
    color: rgb(180, 180, 180);
    padding: 5px 7px;
}

QPushButton#AiHeaderAction:hover {
    color: white;
    background: rgb(49, 49, 49);
}

QPushButton#AiTopAction {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: rgb(170, 170, 174);
    font-size: 19px;
    font-weight: 400;
    padding: 0px;
}

QPushButton#AiTopAction:hover,
QPushButton#AiTopAction:pressed {
    background: rgb(49, 49, 51);
    border: 1px solid transparent;
    color: rgb(232, 232, 234);
}

QPushButton#AiTopAction:disabled {
    background: transparent;
    border: 1px solid transparent;
    color: rgb(91, 91, 94);
}

QPushButton#AiTopAction::menu-indicator {
    image: none;
    width: 0px;
}

QMenu#AiSettingsMenu,
QMenu#AiProviderMenu,
QMenu#AiContextMenu {
    border: 1px solid rgb(58, 58, 60);
    border-radius: 14px;
    color: rgb(216, 216, 219);
    padding: 8px 6px;
}

QMenu#AiSettingsMenu {
    min-width: 270px;
}

QMenu#AiProviderMenu {
    min-width: 150px;
}

QMenu#AiContextMenu {
    min-width: 190px;
}

QMenu#AiSettingsMenu::item,
QMenu#AiProviderMenu::item,
QMenu#AiContextMenu::item {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 8px 28px 8px 11px;
}

QMenu#AiSettingsMenu::item:selected,
QMenu#AiProviderMenu::item:selected,
QMenu#AiContextMenu::item:selected {
    background: rgb(59, 59, 61);
    color: white;
}

QMenu#AiSettingsMenu::item:disabled,
QMenu#AiProviderMenu::item:disabled,
QMenu#AiContextMenu::item:disabled {
    color: rgb(105, 105, 108);
}

QMenu#AiSettingsMenu::separator,
QMenu#AiProviderMenu::separator,
QMenu#AiContextMenu::separator {
    background: rgb(66, 66, 68);
    height: 1px;
    margin: 5px 10px;
}

QMenu#AiSettingsMenu::indicator,
QMenu#AiProviderMenu::indicator,
QMenu#AiContextMenu::indicator {
    width: 13px;
    height: 13px;
    margin-left: 8px;
}

QWidget#AiSettingsAccount,
QWidget#AiSettingsAccount QLabel {
    background: transparent;
}

QWidget#AiSettingsAccount {
    min-width: 252px;
}

QLabel#AiSettingsProviderLogo {
    background: rgb(232, 232, 233);
    border: 1px solid rgb(198, 198, 200);
    border-radius: 15px;
    color: rgb(31, 31, 32);
    font-size: 13px;
    font-weight: 700;
}

QLabel#AiSettingsProviderName {
    color: rgb(218, 218, 221);
    font-size: 13px;
    font-weight: 600;
}

QLabel#AiSettingsConnection {
    color: rgb(151, 151, 155);
    font-size: 11px;
}

QScrollArea#AiTranscript {
    background: transparent;
    border: none;
}

QScrollArea#AiTranscript > QWidget,
QScrollArea#AiTranscript > QWidget > QWidget {
    background: transparent;
    border: none;
}

QWidget#AiMessageList,
QWidget#AiMessageRow {
    background: transparent;
}

QWidget#AiEmptyState {
    background: transparent;
    border: none;
}

QLabel#AiEmptyLogo {
    background: rgb(238, 238, 239);
    border: 1px solid rgb(205, 205, 207);
    border-radius: 35px;
    color: rgb(24, 24, 25);
    font-size: 18px;
    font-weight: 700;
}

QLabel#AiEmptyHeading {
    background: transparent;
    border: none;
    color: white;
    font-size: 18px;
    font-weight: 600;
}

QWidget#AiSentMessageGroup,
QWidget#AiSentContext {
    background: transparent;
    border: none;
}

QLabel#AiUserBubble {
    background: rgb(61, 61, 61);
    border: 1px solid rgb(76, 76, 76);
    border-radius: 11px;
    padding: 9px 11px;
}

QToolButton#AiSentContextToggle {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: rgb(158, 158, 162);
    padding: 3px 6px;
}

QToolButton#AiSentContextToggle:hover,
QToolButton#AiSentContextToggle:pressed,
QToolButton#AiSentContextToggle:checked {
    background: rgb(51, 51, 53);
    border: 1px solid transparent;
    color: rgb(213, 213, 216);
}

QWidget#AiSentContextBody {
    background: rgb(45, 45, 46);
    border: 1px solid rgb(65, 65, 67);
    border-radius: 10px;
}

QWidget#AiSentContextItem {
    background: transparent;
    border: none;
}

QLabel#AiSentContextIcon {
    background: rgb(27, 27, 28);
    border: none;
    border-radius: 8px;
    color: rgb(200, 200, 203);
}

QLabel#AiSentContextTitle {
    background: transparent;
    border: none;
    color: palette(text);
}

QLabel#AiSentContextKind {
    background: transparent;
    border: none;
    color: rgb(145, 145, 149);
}

QTextBrowser#AiAssistantBubble,
QTextBrowser#AiAssistantBubble > QWidget,
QTextBrowser#AiAssistantBubble > QWidget > QWidget {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: palette(text);
    padding: 0px;
    selection-background-color: rgb(72, 92, 77);
    selection-color: white;
}

QLabel#AiErrorBubble {
    background: rgb(82, 43, 43);
    border: 1px solid rgb(111, 57, 57);
    border-radius: 11px;
    padding: 9px 11px;
}

QLabel#AiActivity {
    color: rgb(150, 150, 150);
    padding-left: 6px;
}

QWidget#AiComposerFrame {
    background: rgb(45, 45, 46);
    border: 1px solid rgb(66, 66, 68);
    border-radius: 24px;
}

QWidget#AiComposerFrame:hover {
    border: 1px solid rgb(80, 80, 83);
}

QWidget#AiComposerFrame[inputFocused="true"] {
    border: 1px solid rgb(98, 98, 102);
}

QWidget#AiComposerFrame[dropActive="true"] {
    background: rgb(50, 50, 52);
    border: 1px solid rgb(126, 126, 132);
}

QScrollArea#AiAttachmentStrip,
QScrollArea#AiAttachmentStrip > QWidget,
QScrollArea#AiAttachmentStrip > QWidget > QWidget,
QWidget#AiAttachmentList {
    background: transparent;
    border: none;
}

QWidget#AiAttachmentChip {
    background: rgb(48, 48, 49);
    border: 1px solid rgb(66, 66, 68);
    border-radius: 15px;
}

QLabel#AiAttachmentIcon {
    background: rgb(25, 25, 26);
    border: none;
    border-radius: 12px;
    color: rgb(200, 200, 203);
    font-weight: 700;
}

QLabel#AiAttachmentTitle {
    background: transparent;
    border: none;
    color: rgb(218, 218, 221);
    font-weight: 600;
}

QLabel#AiAttachmentKind {
    background: transparent;
    border: none;
    color: rgb(145, 145, 149);
}

QPushButton#AiAttachmentRemove {
    background: rgb(199, 199, 201);
    border: 1px solid transparent;
    border-radius: 12px;
    color: rgb(43, 43, 44);
    font-weight: 500;
    padding: 0px;
}

QPushButton#AiAttachmentRemove:hover,
QPushButton#AiAttachmentRemove:pressed,
QPushButton#AiAttachmentRemove:focus {
    background: rgb(224, 224, 226);
    border: 1px solid transparent;
    color: rgb(25, 25, 26);
}

QPlainTextEdit#AiPrompt {
    background: transparent;
    border: none;
    padding: 3px 7px;
}

QPushButton#AiComposerAction {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 16px;
    color: rgb(190, 190, 194);
    font-size: 12px;
    font-weight: 300;
    padding: 0px;
}

QWidget#AiAssistant QPushButton#AiComposerAction:hover,
QWidget#AiAssistant QPushButton#AiComposerAction:pressed,
QWidget#AiAssistant QPushButton#AiComposerAction:focus {
    background: rgb(59, 59, 61);
    border: 1px solid transparent;
    color: white;
}

QWidget#AiAssistant QPushButton#AiComposerAction:disabled {
    background: transparent;
    border: 1px solid transparent;
    color: rgb(105, 105, 108);
}

QPushButton#AiComposerAction::menu-indicator {
    image: none;
    width: 0px;
}

QWidget#AiAssistant QComboBox#AiModelSelector {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: rgb(185, 185, 189);
    /* The drop-down subcontrol already reserves its own 16px. Extra right
     * padding here used to reserve that space a second time, causing short
     * names such as "5.6 Sol" to elide while empty box width remained. */
    padding: 5px 2px 5px 7px;
}

QWidget#AiAssistant QComboBox#AiModelSelector:hover,
QWidget#AiAssistant QComboBox#AiModelSelector:focus {
    background: rgb(59, 59, 61);
    border: 1px solid transparent;
    color: white;
}

QComboBox#AiModelSelector::drop-down {
    border: none;
    width: 16px;
}

QWidget#AiAssistant QPushButton#AiSendButton {
    border: 1px solid rgb(132, 132, 135);
    border-radius: 18px;
    color: rgb(35, 35, 36);
    padding: 0px;
    font-weight: 600;
}

QWidget#AiAssistant QPushButton#AiSendButton:hover,
QWidget#AiAssistant QPushButton#AiSendButton:pressed {
    border: 1px solid rgb(155, 155, 158);
    border: none;
}

QWidget#AiAssistant QPushButton#AiSendButton:disabled {
    background: rgb(77, 77, 79);
    color: rgb(119, 119, 122);
}

/* Provider-specific interaction accents. These selectors are intentionally
 * rooted at AiAssistant so the editor's default green remains unchanged. */
QWidget#AiAssistant[providerTheme="openai"] QLabel#AiLink:hover {
    color: rgb(151, 119, 224);
}

QWidget#AiAssistant[providerTheme="openai"] QComboBox:hover,
QWidget#AiAssistant[providerTheme="openai"] QWidget#AiCredentialFrame:hover,
QWidget#AiAssistant[providerTheme="openai"] QLabel#AiUserBubble:hover,
QWidget#AiAssistant[providerTheme="openai"] QLabel#AiErrorBubble:hover,
QWidget#AiAssistant[providerTheme="openai"] QPushButton:hover {
    border: 1px solid rgb(139, 105, 211);
}

QWidget#AiAssistant[providerTheme="openai"] QComboBox:focus,
QWidget#AiAssistant[providerTheme="openai"] QWidget#AiCredentialFrame[inputFocused="true"],
QWidget#AiAssistant[providerTheme="openai"] QPushButton:focus {
    border: 1px solid rgb(75, 132, 224);
}

QWidget#AiAssistant[providerTheme="openai"] QPushButton#AiSecondaryButton,
QWidget#AiAssistant[providerTheme="openai"] QPushButton#AiCredentialSubmit:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgb(65, 126, 216), stop: 1 rgb(132, 80, 187)
    );
}

QWidget#AiAssistant[providerTheme="claude"] QLabel#AiLink:hover {
    color: rgb(224, 137, 87);
}

QWidget#AiAssistant[providerTheme="claude"] QComboBox:hover,
QWidget#AiAssistant[providerTheme="claude"] QWidget#AiCredentialFrame:hover,
QWidget#AiAssistant[providerTheme="claude"] QLabel#AiUserBubble:hover,
QWidget#AiAssistant[providerTheme="claude"] QLabel#AiErrorBubble:hover,
QWidget#AiAssistant[providerTheme="claude"] QPushButton:hover {
    border: 1px solid rgb(218, 123, 70);
}

QWidget#AiAssistant[providerTheme="claude"] QComboBox:focus,
QWidget#AiAssistant[providerTheme="claude"] QWidget#AiCredentialFrame[inputFocused="true"],
QWidget#AiAssistant[providerTheme="claude"] QPushButton:focus {
    border: 1px solid rgb(239, 145, 83);
}

QWidget#AiAssistant[providerTheme="claude"] QPushButton#AiSecondaryButton,
QWidget#AiAssistant[providerTheme="claude"] QPushButton#AiCredentialSubmit:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgb(193, 86, 43), stop: 1 rgb(225, 139, 73)
    );
}

QWidget#AiAssistant[providerTheme="gemini"] QLabel#AiLink:hover {
    color: rgb(234, 67, 53);
}

QWidget#AiAssistant[providerTheme="gemini"] QComboBox:hover,
QWidget#AiAssistant[providerTheme="gemini"] QWidget#AiCredentialFrame:hover,
QWidget#AiAssistant[providerTheme="gemini"] QLabel#AiUserBubble:hover,
QWidget#AiAssistant[providerTheme="gemini"] QLabel#AiErrorBubble:hover,
QWidget#AiAssistant[providerTheme="gemini"] QPushButton:hover {
    border: 1px solid rgb(52, 168, 83);
}

QWidget#AiAssistant[providerTheme="gemini"] QComboBox:focus,
QWidget#AiAssistant[providerTheme="gemini"] QWidget#AiCredentialFrame[inputFocused="true"],
QWidget#AiAssistant[providerTheme="gemini"] QPushButton:focus {
    border: 1px solid rgb(66, 133, 244);
}

QWidget#AiAssistant[providerTheme="gemini"] QPushButton#AiSecondaryButton,
QWidget#AiAssistant[providerTheme="gemini"] QPushButton#AiCredentialSubmit:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgb(66, 133, 244),
        stop: 0.34 rgb(234, 67, 53),
        stop: 0.67 rgb(251, 188, 4),
        stop: 1 rgb(52, 168, 83)
    );
}

/* Header actions stay neutral even when provider-specific form controls use
 * their accent borders. */
QWidget#AiAssistant QPushButton#AiTopAction:hover,
QWidget#AiAssistant QPushButton#AiTopAction:pressed,
QWidget#AiAssistant QPushButton#AiTopAction:focus {
    background: rgb(49, 49, 51);
    border: 1px solid transparent;
    color: rgb(232, 232, 234);
}

/* Attachment close buttons stay neutral across provider themes. */
QWidget#AiAssistant QPushButton#AiAttachmentRemove:hover,
QWidget#AiAssistant QPushButton#AiAttachmentRemove:pressed,
QWidget#AiAssistant QPushButton#AiAttachmentRemove:focus {
    background: rgb(224, 224, 226);
    border: 1px solid transparent;
    color: rgb(25, 25, 26);
}
