/*===========================================================================
 * Colors
 *===========================================================================*/


/*===========================================================================
 * QWidget
 *===========================================================================*/
QWidget 
{
    background: palette(window);
    font-family: "Segoe UI";
    font-size: 11px;
}

#RuntimeBar
{
    background: rgb(18, 18, 18);
}


/*===========================================================================
 * QPushButton
 *===========================================================================*/
QPushButton
{
	background: palette(button);
    border: 2px solid transparent;
    border-radius: 7px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
}

QPushButton:hover
{
    background: rgb(52, 52, 52);
}

QPushButton:pressed
{
    border: 2px solid transparent;
    background: rgb(29, 29, 29);
}

QPushButton:disabled
{
    background: rgb(47, 47, 47);
    color: rgb(90, 90, 90);
}




/*===========================================================================
 * QToolButton
 *===========================================================================*/
QToolButton
{
	background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    text-align: center;
}

QToolButton:hover
{
	background: rgb(52, 52, 52);
    color: white;
}

QToolButton:pressed,
QToolButton:checked
{
    background: rgb(59, 59, 61);
}

/* Collapse arrows communicate hierarchy rather than an action surface. Keep
 * them visually bare in every interaction state. */
CollapsableWidget QToolButton,
CollapsableWidget QToolButton:hover,
CollapsableWidget QToolButton:pressed,
CollapsableWidget QToolButton:checked,
QToolButton#CollapseToggleButton,
QToolButton#CollapseToggleButton:hover,
QToolButton#CollapseToggleButton:pressed,
QToolButton#CollapseToggleButton:checked
{
    background: transparent;
    border: none;
    border-radius: 0px;
}


/*===========================================================================
 * QRadioButton
 *===========================================================================*/
QRadioButton::indicator
{
    border: 2px solid rgb(150, 150, 150);
    border-radius: 9px;
    width: 14px;
    height: 14px;
    background: transparent;
}

QRadioButton::indicator:disabled
{
    border-color: rgb(80, 80, 80);
    background-color: rgb(63, 63, 63);
}

QRadioButton::indicator:hover
{
    border-color: rgb(131, 176, 145);
}

QRadioButton::indicator:checked
{
    border-color: rgb(45, 54, 48);
    background-color: rgb(69, 185, 106);

}

QRadioButton::indicator:checked:disabled
{
    border-color: rgb(87, 126, 100);
    background-color: rgb(87, 126, 100);

}

QRadioButton::indicator:checked:hover
{
    border-color: rgb(45, 54, 48);
    background-color: rgb(132, 178, 151);
}


/*===========================================================================
 * QComboBox
 *===========================================================================*/
QComboBox
{
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 4px;
}

QComboBox:hover
{
    background: rgb(26, 26, 26);
    border: 1px solid transparent;
}

QComboBox:focus,
QComboBox:on
{
    background: rgb(18, 18, 18);
    border: 1px solid transparent;
}

/*---------------------------------------------------------------------------
 * The drop-down popup. Styled to match QMenu below so a combo box and a menu
 * read as the same control -- both are "pick one of these".
 *
 * The rounded container depends on Editor::Init's popup translucency filter:
 * Qt draws the rounded rect inside an opaque native popup window, so without it
 * the square corners of that window show through behind the curve.
 *-------------------------------------------------------------------------*/
QComboBoxPrivateContainer
{
    background: transparent;
    border: none;
}

QComboBox QAbstractItemView
{
    background: rgb(38, 38, 39);
    border: 1px solid rgb(58, 58, 60);
    border-radius: 12px;
    padding: 6px;
    color: rgb(216, 216, 219);
    /* Kills the focus rectangle Fusion would draw around the whole list, which
     * would otherwise square off the rounded frame from the inside. */
    outline: none;
    /* The ::item rules below own selection painting; leaving this set would
     * paint a square highlight underneath their rounded one. */
    selection-background-color: transparent;
}

QComboBox QAbstractItemView::item
{
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 6px 10px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover
{
    background: rgb(59, 59, 61);
    color: white;
}

QComboBox QAbstractItemView::item:disabled
{
    color: rgb(105, 105, 108);
}


QComboBox::drop-down
{
    border: none;
    padding-right: 8px;
}

QComboBox::down-arrow
{
    /* image: url(:/style/images/checkbox_down_arrow.svg); */
    height: 6px;
    width: 12px;
}


/*===========================================================================
 * QCheckBox
 *===========================================================================*/
.QCheckBox::indicator
{
    border: 2px solid rgb(150, 150, 150);
    border-radius: 9px;
    width: 14px;
    height: 14px;
    background: transparent;
}

.QCheckBox::indicator:disabled
{
    border-color: rgb(80, 80, 80);
    background-color: rgb(63, 63, 63);
}

.QCheckBox::indicator:hover
{
    border-color: rgb(131, 176, 145);
}

.QCheckBox::indicator:checked
{
    border-color: rgb(45, 54, 48);
    background-color: rgb(69, 185, 106);
}

.QCheckBox::indicator:checked:disabled
{
    border-color: rgb(87, 126, 100);
    background-color: rgb(87, 126, 100);
}

.QCheckBox::indicator:checked:hover
{
    border-color: rgb(45, 54, 48);
    background-color: rgb(132, 178, 151);
}


/*===========================================================================
 * QLineEdit
 *===========================================================================*/
QLineEdit {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    color: rgb(220, 220, 220);
    selection-background-color: rgb(70, 70, 70);
    selection-color: rgb(255, 255, 255);
}

QLineEdit:hover {
    background: rgb(26, 26, 26);
    border: 1px solid transparent;
}

QLineEdit:focus {
    background: rgb(18, 18, 18);
    border: 1px solid transparent;
}

QLineEdit:disabled {
    color: rgb(100, 100, 100);
    background: transparent;
    border: 1px solid transparent;
}


/*===========================================================================
 * ResizableTextEdit (the Tags::MULTILINE property widget)
 *
 * Deliberately identical to QLineEdit above: a paragraph field is the same kind
 * of input, just taller, and a second palette for it would read as a different
 * control. Padding stays small because the drag grip lives inside the frame.
 *===========================================================================*/
ResizableTextEdit {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px;
    color: rgb(220, 220, 220);
    selection-background-color: rgb(70, 70, 70);
    selection-color: rgb(255, 255, 255);
}

ResizableTextEdit:hover {
    background: rgb(26, 26, 26);
    border: 1px solid transparent;
}

ResizableTextEdit:focus {
    background: rgb(18, 18, 18);
    border: 1px solid transparent;
}

ResizableTextEdit:disabled {
    color: rgb(100, 100, 100);
    background: transparent;
    border: 1px solid transparent;
}


/*===========================================================================
 * QScrollBar
 *
 * A narrow, quiet track with a rounded thumb. The 17px extent intentionally
 * becomes roughly the reference's 34px physical width on a 2x display, while
 * remaining compact on a standard-density monitor. Arrow primitives remain
 * style-drawn so vertical and horizontal bars share the platform's crisp DPI
 * rendering without another set of bitmap assets.
 *===========================================================================*/
QScrollBar:vertical {
    border: none;
    width: 17px;
    margin: 17px 0px 17px 0px;
    color: rgb(54, 54, 54);
}

QScrollBar::handle:vertical {
    background: rgb(53, 53, 53);
    border: none;
    border-radius: 9px;
    min-height: 36px;
    margin: 2px 4px 2px 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgb(66, 66, 66);
}

QScrollBar::handle:vertical:pressed {
    background: rgb(78, 78, 78);
}

QScrollBar::sub-line:vertical,
QScrollBar::add-line:vertical {
    background: transparent;
    border: none;
    height: 17px;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
    subcontrol-position: top;
}

QScrollBar::add-line:vertical {
    subcontrol-position: bottom;
}

QScrollBar::sub-line:vertical:hover,
QScrollBar::add-line:vertical:hover,
QScrollBar::sub-line:vertical:pressed,
QScrollBar::add-line:vertical:pressed {
    background: transparent;
}

QScrollBar::up-arrow:vertical {
    background: transparent;
    image: url("__SCROLL_ARROW_UP__");
    width: 7px;
    height: 5px;
}

QScrollBar::down-arrow:vertical {
    background: transparent;
    image: url("__SCROLL_ARROW_DOWN__");
    width: 7px;
    height: 5px;
}

QScrollBar:horizontal {
    background: rgb(22, 22, 22);
    border: none;
    height: 17px;
    margin: 0px 17px 0px 17px;
    color: rgb(54, 54, 54);
}

QScrollBar::handle:horizontal {
    background: rgb(53, 53, 53);
    border: none;
    border-radius: 9px;
    min-width: 36px;
    margin: 4px 2px 4px 2px;
}

QScrollBar::handle:horizontal:hover {
    background: rgb(66, 66, 66);
}

QScrollBar::handle:horizontal:pressed {
    background: rgb(78, 78, 78);
}

QScrollBar::sub-line:horizontal,
QScrollBar::add-line:horizontal {
    background: transparent;
    border: none;
    width: 17px;
    subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
    subcontrol-position: left;
}

QScrollBar::add-line:horizontal {
    subcontrol-position: right;
}

QScrollBar::sub-line:horizontal:hover,
QScrollBar::add-line:horizontal:hover,
QScrollBar::sub-line:horizontal:pressed,
QScrollBar::add-line:horizontal:pressed {
    background: transparent;
}

QScrollBar::left-arrow:horizontal {
    background: transparent;
    image: url("__SCROLL_ARROW_LEFT__");
    width: 5px;
    height: 7px;
}

QScrollBar::right-arrow:horizontal {
    background: transparent;
    image: url("__SCROLL_ARROW_RIGHT__");
    width: 5px;
    height: 7px;
}

QScrollBar::sub-page:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:horizontal,
QScrollBar::add-page:horizontal {
    background: transparent;
    border: none;
}

QScrollBar::handle:vertical:disabled,
QScrollBar::handle:horizontal:disabled {
    background: transparent;
}

QAbstractScrollArea::corner {
    background: rgb(22, 22, 22);
    border: none;
}


/*===========================================================================
 * QSpinBox / QDoubleSpinBox
 *
 * Both are listed explicitly because QDoubleSpinBox is NOT a QSpinBox subclass --
 * they are siblings under QAbstractSpinBox -- so a lone `QSpinBox` selector would
 * silently miss every numeric field in the inspector, which are all doubles.
 *
 * The frame matches QLineEdit exactly: a number field and a text field are the same
 * kind of control, and they sit on adjacent inspector rows where any difference in
 * height or border reads as a mistake.
 *
 * Two populations exist and both are covered here:
 *   - Inspector fields (PropertyWidget's ConfigureSpinBox) set NoButtons, so the
 *     sub-control rules below simply don't render for them.
 *   - AnimatorGui (fps/speed/exit time/threshold) and the Sprite Editor's slice
 *     counts keep their buttons, and were falling back to raw Fusion chrome.
 *===========================================================================*/
QSpinBox,
QDoubleSpinBox {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    color: rgb(220, 220, 220);
    selection-background-color: rgb(70, 70, 70);
    selection-color: rgb(255, 255, 255);
}

QSpinBox:hover,
QDoubleSpinBox:hover {
    background: rgb(26, 26, 26);
    border: 1px solid transparent;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    background: rgb(18, 18, 18);
    border: 1px solid transparent;
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: rgb(100, 100, 100);
    background: transparent;
    border: 1px solid transparent;
}

/* Read-only (PropDesc::ReadOnly / Tags::READONLY display rows). Dimmer than a live
 * field but clearly brighter than a disabled one -- the value still matters, it just
 * can't be edited. */
QSpinBox:read-only,
QDoubleSpinBox:read-only {
    color: rgb(150, 150, 150);
    background: transparent;
    border: 1px solid transparent;
}

/*---------------------------------------------------------------------------
 * Steppers. subcontrol-origin is `border` so they sit flush inside the frame
 * instead of being inset by the 4px text padding, which would leave a dead strip
 * of background down the right edge.
 *-------------------------------------------------------------------------*/
QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    background: transparent;
    border: none;
    border-top-right-radius: 6px;
    margin: 1px 1px 0px 0px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    background: transparent;
    border: none;
    border-bottom-right-radius: 6px;
    margin: 0px 1px 1px 0px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: rgb(58, 58, 58);
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: rgb(87, 126, 100);
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled {
    background: transparent;
}

/* Sized but deliberately image-less, exactly like QComboBox::down-arrow above: Qt
 * draws its own arrow primitive, so the theme needs no icon assets to ship. */
QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 7px;
    height: 5px;
}


/*===========================================================================
 * QProgressBar (the loading overlay's bar)
 *
 * There was no rule for this at all, so a stock bar rendered in raw Fusion
 * colours against the dark theme. Flat, no text, no border -- it sits inside
 * the overlay card, which already supplies the frame.
 *===========================================================================*/
QProgressBar {
    background-color: rgb(45, 45, 45);
    border: none;
    border-radius: 3px;
}

QProgressBar::chunk {
    background-color: rgb(87, 126, 100);
    border-radius: 3px;
}


/*===========================================================================
 * ListRemoveButton (the trash button on editable list rows)
 *
 * Red because it is the one destructive control in a row of neutral ones, and
 * the "×" it replaced read as "close this" rather than "delete this". Muted at
 * rest so a long list isn't a wall of red; full strength on hover, when the
 * pointer has already committed to the row.
 *
 * The generic QPushButton rule above sets 14px side padding, which would push a
 * 14px icon out of a 24px button -- hence the explicit padding reset.
 *===========================================================================*/
QPushButton#ListRemoveButton {
    background: rgb(104, 44, 44);
    border: 1px solid rgb(132, 56, 56);
    border-radius: 2px;
    padding: 0px;
}

QPushButton#ListRemoveButton:hover {
    background: rgb(158, 58, 58);
    border: 1px solid rgb(190, 78, 78);
}

QPushButton#ListRemoveButton:pressed {
    background: rgb(88, 36, 36);
}


/*===========================================================================
 * CToggleSwitch
 *===========================================================================*/
CToggleSwitch
{
    min-height: 24px;
}


CToggleSwitch::indicator
{
   /* image: url(:/style/images/toggleswitch_off.svg); */
   background-color: rgb(150, 150, 150);
   border-radius: 12px;
   width: 44px;
   height: 24px;
   padding: 0px;
}


CToggleSwitch::indicator::checked
{
   /* image: url(:/style/images/toggleswitch_on.svg); */
   background-color: rgb(0, 120, 215);
}


/*===========================================================================
 * QToolBar
 *===========================================================================*/
 QMenuBar
 {
    background: rgb(27, 27, 27);
 }


QMenuBar::item
{
   background: none;
   border: none;
   border-radius: 7px;
   padding-bottom: 10px;
   padding-top: 11px;
   padding-left: 12px;
   padding-right: 12px;
}


QMenuBar::item:selected
{
   background: rgb(52, 52, 52);
   border: none;
}


/*===========================================================================
 * QMenu
 *
 * Covers every popup menu in the editor -- the menu bar's dropdowns and the
 * Hierarchy / Folder view context menus -- and is deliberately the same shape
 * as the combo box popup above, so the two never read as different controls.
 *
 * The rounded container depends on Editor::Init's popup translucency filter;
 * see the note on QComboBoxPrivateContainer for why a border-radius alone is
 * not enough.
 *===========================================================================*/
QMenu
{
    background: rgb(38, 38, 39);
    border: 1px solid rgb(58, 58, 60);
    border-radius: 12px;
    color: rgb(216, 216, 219);
    padding: 6px;
}

QMenu::item
{
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 6px 24px 6px 10px;
}

QMenu::item:selected
{
    background: rgb(59, 59, 61);
    color: white;
}

QMenu::item:disabled
{
    color: rgb(105, 105, 108);
}

QMenu::separator
{
    background: rgb(66, 66, 68);
    height: 1px;
    margin: 5px 8px;
}

QMenu::indicator
{
    width: 13px;
    height: 13px;
    margin-left: 6px;
}


/*===========================================================================
 * Item views
 *
 * Keep rows visually separate instead of painting one continuous rectangular
 * selection strip. Combo-box popups use the same radius and hover colour.
 *===========================================================================*/
QTreeView,
QListView
{
    outline: none;
    selection-background-color: transparent;
}

QTreeView::item,
QListView::item
{
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 3px 7px;
}

QTreeView::item:hover,
QListView::item:hover
{
    background: rgb(49, 49, 51);
}

QTreeView::item:selected,
QListView::item:selected
{
    background: rgb(59, 59, 61);
    color: white;
}

QTreeView::item:disabled,
QListView::item:disabled
{
    color: rgb(105, 105, 108);
}

/* Shared disclosure arrows for every tree, including File Explorer. Branch
 * cells keep the view surface in selected rows instead of inheriting the item
 * highlight; the rounded selection begins at the item icon and label. */
QTreeView::branch,
QTreeView::branch:hover,
QTreeView::branch:selected,
QTreeView::branch:selected:hover
{
    background: palette(window);
    border: none;
}

QTreeView::branch:closed:has-children
{
    image: url("__SCENE_TREE_ARROW_RIGHT__");
}

QTreeView::branch:open:has-children
{
    image: url("__SCENE_TREE_ARROW_DOWN__");
}


/*===========================================================================
 * SceneTree
 *===========================================================================*/
SceneTree
{
    background: rgb(32, 32, 32);
    border: none;
    color: palette(text);
    outline: none;
    selection-background-color: transparent;
    show-decoration-selected: 0;
}

SceneTree QHeaderView::section
{
}

SceneTree::item
{
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 2px 6px;
}

SceneTree::item:hover
{
    background: rgb(49, 49, 51);
}

SceneTree::item:selected
{
    background: rgb(59, 59, 61);
    border: 1px solid rgb(87, 126, 100);
    color: white;
}

SceneTree::item:selected:!active
{
    background: rgb(52, 52, 54);
    border: 1px solid rgb(72, 92, 77);
    color: white;
}

SceneTree::item:disabled
{
    color: rgb(90, 90, 90);
    font-style: italic;
}

SceneTree::item:disabled:selected
{
    background: rgb(52, 52, 54);
    border: 1px solid rgb(72, 92, 77);
}

/* SceneTree has its own fixed surface colour, so override only the shared
 * branch background while inheriting the common disclosure arrow images. */
SceneTree::branch,
SceneTree::branch:hover,
SceneTree::branch:selected,
SceneTree::branch:selected:hover
{
    background: rgb(32, 32, 32);
    border: none;
}

CollapsableWidget QWidget#collapsableHeader
{
    background: rgb(43, 43, 45);
    border: none;
    border-radius: 7px;
}

CollapsableWidget QWidget#collapsableHeader:hover
{
    background: rgb(49, 49, 51);
}

CollapsableWidget QLabel#CollapsableHeaderIcon
{
    background: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
}

CollapsableWidget QCheckBox#CollapsableActiveToggle,
CollapsableWidget QCheckBox#CollapsableActiveToggle:hover,
CollapsableWidget QCheckBox#CollapsableActiveToggle:pressed,
CollapsableWidget QCheckBox#CollapsableActiveToggle:checked,
CollapsableWidget QCheckBox#CollapsableActiveToggle:disabled
{
    background: transparent;
    border: none;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

CollapsableWidget QLineEdit#Label 
{
    background: none;
    background-color: transparent;
    border: none;
    outline: none;       
    padding: 0px;
}

CollapsableWidget QLineEdit#Label:hover, 
CollapsableWidget QLineEdit#Label:focus, 
CollapsableWidget QLineEdit#Label:disabled 
{
    background: transparent;
    border: none;
    outline: none;
}
/*===========================================================================
 * ActiveToggleBtn (SceneTree hover active toggle)
 *===========================================================================*/
QToolButton#ActiveToggleBtn {
    border: 2px solid rgb(150, 150, 150);
    border-radius: 6px;
    background: transparent;
    padding: 0px;
}

QToolButton#ActiveToggleBtn:hover {
    border-color: rgb(131, 176, 145);
}

QToolButton#ActiveToggleBtn:checked {
    border-color: rgb(45, 54, 48);
    background-color: rgb(69, 185, 106);
}

QToolButton#ActiveToggleBtn:checked:hover {
    background-color: rgb(132, 178, 151);
}


/*===========================================================================
 * ColorButton (Inspector color picker)
 *===========================================================================*/
QPushButton#ColorButton
{
    border: 1px solid #333;
    border-radius: 10px;
}


/*===========================================================================
 * QDockWidget
 *===========================================================================*/
QDockWidget {
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(undock.png);
}

QDockWidget::title {
    border: 1px solid rgb(39, 39, 39);
    font-weight: bold;
    padding-left: 2px;    /* Keeps text away from the left edge */
    padding-top: 2px;      /* Centers it vertically */
    subcontrol-origin: margin; 
    subcontrol-position: top;
}
