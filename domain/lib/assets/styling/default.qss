/*===========================================================================
 * Colors
 *===========================================================================*/


/*===========================================================================
 * QWidget
 *===========================================================================*/
QWidget 
{
    background: palette(window);
    font-family: "Segoe UI";
    font-size: 14px;
}

#RuntimeBar
{
    background: rgb(18, 18, 18);
}


/*===========================================================================
 * QPushButton
 *===========================================================================*/
QPushButton
{
	background: palette(button);
    border: 2px solid transparent;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
}

QPushButton:hover
{
    background: rgb(52, 52, 52);
}

QPushButton:pressed
{
    border: 2px solid transparent;
    background: rgba(0, 0, 0, 102);
}




/*===========================================================================
 * QToolButton
 *===========================================================================*/
QToolButton
{
	background: transparent;
    border: none;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
}

QToolButton:hover
{
	background: palette(button);
}

QToolButton:pressed
{
	  background: palette(dark);
}

QToolButton:checked:!pressed:enabled
{
	  background: rgb(0, 99, 177);
      color: rgb(255, 255, 255);
}


/*===========================================================================
 * QRadioButton
 *===========================================================================*/
QRadioButton::indicator
{
    border: 2px solid rgb(150, 150, 150);
    border-radius: 9px;
    width: 14px;
    height: 14px;
    background: transparent;
}

QRadioButton::indicator:disabled
{
    border-color: rgb(100, 100, 100);
}

QRadioButton::indicator:hover
{
    border-color: rgb(131, 176, 145);
}

QRadioButton::indicator:checked
{
    border-color: rgb(73, 155, 99);
    background-color: rgb(73, 155, 99);

}

QRadioButton::indicator:checked:disabled
{
    border-color: rgb(100, 100, 100);
    background-color: rgb(100, 100, 100);
}

QRadioButton::indicator:checked:hover
{
    border-color: rgb(132, 178, 151);
    background-color: rgb(132, 178, 151);
}


/*===========================================================================
 * QComboBox
 *===========================================================================*/
QComboBox
{
    border: 2px solid rgb(51, 51, 51);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 4px;
}


QComboBox:hover:!pressed
{
    border-color: rgb(102, 102, 102);
}

QComboBox QAbstractItemView::item
{
	padding-top: 3px;
    padding-bottom: 4px;
}


QComboBox::drop-down
{
    border: none;
    padding-right: 8px;
}

QComboBox::down-arrow
{
    /* image: url(:/style/images/checkbox_down_arrow.svg); */
    height: 6px;
    width: 12px;
}


/*===========================================================================
 * QCheckBox
 *===========================================================================*/
.QCheckBox::indicator
{
	width: 16px;
    height: 16px;
    border: 2px solid rgb(0, 0, 0);
}


.QCheckBox::indicator:disabled
{
    border: 2px solid rgb(172, 172, 172);
}


.QCheckBox::indicator::pressed
{
    border: 2px solid rgb(102, 102, 102);
    background: rgb(102, 102, 102);
}

.QCheckBox::indicator:checked
{
    image: url(:/style/images/checkbox_checked.svg);
    background: rgb(0, 99, 177);
    border: 2px solid rgb(0, 99, 177);
    /* pure styling no SVG */
}

.QCheckBox::indicator:checked:!pressed
{
    border: 2px solid rgb(0, 99, 177);
    background: rgb(0, 99, 177);
    image: url(:/style/images/checkbox_checked.svg);
}

.QCheckBox::indicator:checked:!pressed:hover
{
    border: 2px solid rgb(0, 0, 0);
}


.QCheckBox::indicator:indeterminate
 {
    background: rgb(0, 99, 177);
    border: 2px solid rgb(0, 99, 177);
}


/*===========================================================================
 * QLineEdit
 *===========================================================================*/
QLineEdit {
    background-color: rgb(30, 30, 30);
    border: 1px solid rgb(51, 51, 51);
    border-radius: 2px;
    padding: 4px;
    color: rgb(220, 220, 220);
    selection-background-color: rgb(70, 70, 70);
    selection-color: rgb(255, 255, 255);
}

QLineEdit:hover {
    border: 1px solid rgb(80, 80, 80);
}

QLineEdit:focus {
    border: 1px solid rgb(100, 100, 100);
    background-color: rgb(35, 35, 35);
}

QLineEdit:disabled {
    color: rgb(100, 100, 100);
    background-color: rgb(25, 25, 25);
    border: 1px solid rgb(40, 40, 40);
}


/*===========================================================================
 * CToggleSwitch
 *===========================================================================*/
CToggleSwitch
{
    min-height: 24px;
}


CToggleSwitch::indicator
{
   /* image: url(:/style/images/toggleswitch_off.svg); */
   background-color: rgb(150, 150, 150);
   border-radius: 12px;
   width: 44px;
   height: 24px;
   padding: 0px;
}


CToggleSwitch::indicator::checked
{
   /* image: url(:/style/images/toggleswitch_on.svg); */
   background-color: rgb(0, 120, 215);
}


/*===========================================================================
 * QToolBar
 *===========================================================================*/
 QMenuBar
 {
    background: rgb(27, 27, 27);
 }


QMenuBar::item
{
   background: none;
   border: none;
   padding-bottom: 10px;
   padding-top: 11px;
   padding-left: 12px;
   padding-right: 12px;
}


QMenuBar::item:selected
{
   background: rgba(0, 0, 0, 30);
   border: none;
}


/*===========================================================================
 * SceneTree
 *===========================================================================*/
SceneTree
{
    color: palette(text);
}

SceneTree::item:selected
{
    background: rgb(0, 99, 177);
    color: rgb(255, 255, 255);
}

SceneTree::item:selected:!active
{
    background: rgb(60, 60, 60);
    color: rgb(255, 255, 255);
}

SceneTree::item:disabled
{
    color: rgb(128, 128, 128);
}

ObjectHeader
{
    
    border-bottom: 1px solid;
    border-color: rgb(67, 67, 67);


}