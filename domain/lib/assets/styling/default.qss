/*===========================================================================
 * Colors
 *===========================================================================*/


/*===========================================================================
 * QWidget
 *===========================================================================*/
QWidget 
{
    background: palette(window);
    font-family: "Segoe UI";
    font-size: 14px;
}

#RuntimeBar
{
    background: rgb(18, 18, 18);
}


/*===========================================================================
 * QPushButton
 *===========================================================================*/
QPushButton
{
	background: palette(button);
    border: 2px solid transparent;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
}

QPushButton:hover
{
    background: rgb(52, 52, 52);
}

QPushButton:pressed
{
    border: 2px solid transparent;
    background: rgba(0, 0, 0, 102);
}




/*===========================================================================
 * QToolButton
 *===========================================================================*/
QToolButton
{
	background: transparent;
    border: none;
    text-align: center;

}

QToolButton:hover
{
	color: white;
}


/*===========================================================================
 * QRadioButton
 *===========================================================================*/
QRadioButton::indicator
{
    border: 2px solid rgb(150, 150, 150);
    border-radius: 9px;
    width: 14px;
    height: 14px;
    background: transparent;
}

QRadioButton::indicator:disabled
{
    border-color: rgb(80, 80, 80);
    background-color: rgb(63, 63, 63);
}

QRadioButton::indicator:hover
{
    border-color: rgb(131, 176, 145);
}

QRadioButton::indicator:checked
{
    border-color: rgb(45, 54, 48);
    background-color: rgb(69, 185, 106);

}

QRadioButton::indicator:checked:disabled
{
    border-color: rgb(87, 126, 100);
    background-color: rgb(87, 126, 100);

}

QRadioButton::indicator:checked:hover
{
    border-color: rgb(45, 54, 48);
    background-color: rgb(132, 178, 151);
}


/*===========================================================================
 * QComboBox
 *===========================================================================*/
QComboBox
{
    border: 2px solid rgb(51, 51, 51);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 4px;
}


QComboBox:hover:!pressed
{
    border-color: rgb(102, 102, 102);
}

QComboBox QAbstractItemView::item
{
	padding-top: 3px;
    padding-bottom: 4px;
}


QComboBox::drop-down
{
    border: none;
    padding-right: 8px;
}

QComboBox::down-arrow
{
    /* image: url(:/style/images/checkbox_down_arrow.svg); */
    height: 6px;
    width: 12px;
}


/*===========================================================================
 * QCheckBox
 *===========================================================================*/
.QCheckBox::indicator
{
    border: 2px solid rgb(150, 150, 150);
    border-radius: 9px;
    width: 14px;
    height: 14px;
    background: transparent;
}

.QCheckBox::indicator:disabled
{
    border-color: rgb(80, 80, 80);
    background-color: rgb(63, 63, 63);
}

.QCheckBox::indicator:hover
{
    border-color: rgb(131, 176, 145);
}

.QCheckBox::indicator:checked
{
    border-color: rgb(45, 54, 48);
    background-color: rgb(69, 185, 106);
}

.QCheckBox::indicator:checked:disabled
{
    border-color: rgb(87, 126, 100);
    background-color: rgb(87, 126, 100);
}

.QCheckBox::indicator:checked:hover
{
    border-color: rgb(45, 54, 48);
    background-color: rgb(132, 178, 151);
}


/*===========================================================================
 * QLineEdit
 *===========================================================================*/
QLineEdit {
    background-color: rgb(30, 30, 30);
    border: 1px solid rgb(51, 51, 51);
    border-radius: 2px;
    padding: 4px;
    color: rgb(220, 220, 220);
    selection-background-color: rgb(70, 70, 70);
    selection-color: rgb(255, 255, 255);
}

QLineEdit:hover {
    border: 1px solid rgb(80, 80, 80);
}

QLineEdit:focus {
    border: 1px solid rgb(100, 100, 100);
    background-color: rgb(35, 35, 35);
}

QLineEdit:disabled {
    color: rgb(100, 100, 100);
    background-color: rgb(25, 25, 25);
    border: 1px solid rgb(40, 40, 40);
}


/*===========================================================================
 * CToggleSwitch
 *===========================================================================*/
CToggleSwitch
{
    min-height: 24px;
}


CToggleSwitch::indicator
{
   /* image: url(:/style/images/toggleswitch_off.svg); */
   background-color: rgb(150, 150, 150);
   border-radius: 12px;
   width: 44px;
   height: 24px;
   padding: 0px;
}


CToggleSwitch::indicator::checked
{
   /* image: url(:/style/images/toggleswitch_on.svg); */
   background-color: rgb(0, 120, 215);
}


/*===========================================================================
 * QToolBar
 *===========================================================================*/
 QMenuBar
 {
    background: rgb(27, 27, 27);
 }


QMenuBar::item
{
   background: none;
   border: none;
   padding-bottom: 10px;
   padding-top: 11px;
   padding-left: 12px;
   padding-right: 12px;
}


QMenuBar::item:selected
{
   background: rgba(0, 0, 0, 30);
   border: none;
}


/*===========================================================================
 * SceneTree
 *===========================================================================*/
SceneTree
{
    color: palette(text);
}

SceneTree::item:selected
{
    background: rgb(0, 99, 177);
    color: rgb(255, 255, 255);
}

SceneTree::item:selected:!active
{
    background: rgb(60, 60, 60);
    color: rgb(255, 255, 255);
}

SceneTree::item:disabled
{
    color: rgb(128, 128, 128);
}

CollapsableWidget ObjectHeader
{
    background-color : rgb(173, 59, 59);;
    border: 1px solid rgb(67, 67, 67);
}

CollapsableWidget QLineEdit#Label 
{
    background: none;
    background-color: transparent;
    border: none;
    outline: none;       
    padding: 0px;
}

CollapsableWidget QLineEdit#Label:hover, 
CollapsableWidget QLineEdit#Label:focus, 
CollapsableWidget QLineEdit#Label:disabled 
{
    background: transparent;
    border: none;
    outline: none;
}
/*===========================================================================
 * ColorButton (Inspector color picker)
 *===========================================================================*/
QPushButton#ColorButton
{
    border: 1px solid #333;
    border-radius: 10px;
}


/*===========================================================================
 * QDockWidget
 *===========================================================================*/
QDockWidget {
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(undock.png);
}

QDockWidget::title {
    border: 1px solid rgb(59, 59, 59);
    font-weight: bold;
    padding-left: 2px;    /* Keeps text away from the left edge */
    padding-top: 2px;      /* Centers it vertically */
    subcontrol-origin: margin; 
    subcontrol-position: top;
}
