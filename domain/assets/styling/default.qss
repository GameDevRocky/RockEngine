/* -------------------------------- */
/* Global font and text settings     */
/* -------------------------------- */
QWidget, QFrame, QDockWidget {
    font-family: Consolas, "Courier New", monospace;
    font-size: 13px;
}

/* -------------------------------- */
/* Panel / editor widget borders     */
/* -------------------------------- */
QWidget#Panel, QFrame#Panel, QDockWidget#Panel {
    border: 1px solid transparent;   /* Palette handles color */
    border-radius: 4px;
    padding: 4px;
    margin: 2px;
}

/* -------------------------------- */
/* Layout spacing for inner widgets  */
/* -------------------------------- */
QVBoxLayout, QHBoxLayout {
    spacing: 4px;
}

/* -------------------------------- */
/* Buttons and ToolButtons           */
/* -------------------------------- */
QPushButton, QToolButton {
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px 6px;
    margin: 0;
}

/* Hover/pressed effects use palette or custom style in code */
QPushButton:hover, QToolButton:hover {
    /* optional: highlight handled via palette */
}

QPushButton:pressed, QToolButton:pressed {
    /* optional: pressed effect handled via palette */
}

/* -------------------------------- */
/* Input fields spacing and rounding */
/* -------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 2px 4px;
    margin: 0;
}

/* -------------------------------- */
/* Labels spacing / hover underline  */
/* -------------------------------- */
QLabel {
    margin: 0;
    padding: 0;
}

QLabel:hover {
    /* hover underline will be handled in code */
}

/* -------------------------------- */
/* Tree/List view spacing and borders */
/* -------------------------------- */
QTreeView, QListView {
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
    margin: 0;
    show-decoration-selected: 1; /* selection highlight */
}

QTreeView::item, QListView::item {
    padding: 2px 4px;
    margin: 0;
}

/* -------------------------------- */
/* Scrollbars rounding and padding   */
/* -------------------------------- */
QScrollBar:horizontal, QScrollBar:vertical {
    border: 0px;
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
}
